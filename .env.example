# Kopiere diese Datei nach .env und trage deine Werte ein.
# Die .env wird nicht hochgeladen, dafuer sorgt die .gitignore.

# Dein persoenlicher Zugang. Jede Person braucht einen eigenen.
EUROUTER_API_KEY=

# Welches Modell die Anwendung benutzt. Bleibt das Feld leer,
# nimmt sie mistral-large-3.
EUROUTER_MODELL=
